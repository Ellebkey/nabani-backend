{
  "name": "nabani-backend",
  "version": "1.0.0",
  "description": "Nabani backend — nutrition-clinic + meal-prep operations API (Node/TS/Express 5/Sequelize 6).",
  "author": "Joel Barranco <hello@joelbarranco.io>",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --inspect src/index.ts",
    "lint": "eslint --quiet ./src",
    "lint:warning": "eslint ./src",
    "test": "cross-env NODE_ENV=test jest --config jest.config.js",
    "test:unit": "cross-env NODE_ENV=test jest --config jest.config.js",
    "test:integration": "cross-env NODE_ENV=test jest --config jest.integration.config.js --runInBand",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage",
    "build": "tsc && tsc-alias",
    "deploy:build": "mkdir backend && cp -r db-migrations/ release/ package.json .sequelizerc backend/ && mv ./backend/release ./backend/src",
    "deploy:prod": "npm run build && npm run deploy:build",
    "release": "commit-and-tag-version",
    "release:major": "commit-and-tag-version --release-as major --skip.commit=true",
    "release:minor": "commit-and-tag-version --release-as minor --skip.commit=true",
    "release-postcommit": "git add CHANGELOG.md package.json && git commit --amend --no-edit",
    "prepare": "husky",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "apikey": "cross-env NODE_ENV=development tsx src/scripts/api-key.ts",
    "apikey:prod": "node src/scripts/api-key.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.0",
    "lodash": "^4.17.21",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.3",
    "redis": "^6.1.0",
    "resend": "^6.9.3",
    "sequelize": "^6.32.0",
    "sequelize-cli": "^6.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.5.2",
    "winston": "^3.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.0",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.195",
    "@types/node": "^24.13.2",
    "@types/supertest": "^7.2.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "commit-and-tag-version": "^12.7.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsc-alias": "^1.8.6",
    "tsx": "^4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "license": "MIT"
}
